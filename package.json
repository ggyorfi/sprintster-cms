{
  "name": "sprintster-cms-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "ref": "tsx scripts/ref.ts",
    "seed": "tsx scripts/seed.ts",
    "dev": "pnpm --dir examples/reference-site dev",
    "daemon": "pnpm --dir examples/reference-site daemon",
    "reset": "pnpm --dir examples/reference-site reset"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "sprintster": "latest",
    "sprintster-cms": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "eta": "^4.6.0",
    "markdown-it": "^14.3.0",
    "sharp": "^0.34.5",
    "shiki": "^3.23.0",
    "zod": "^4.4.3"
  }
}

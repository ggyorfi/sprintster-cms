<% if (size(it.posts) === 0) { %>
<p class="empty">Nothing published yet.</p>
<% } else { %>
<ul class="post-list">
  <% it.posts.forEach(function (post) { %>
  <li class="post-card">
    <% if (post.cover) { %><a href="<%= post.url %>"><%~ include("_picture", { image: post.cover, lazy: true }) %></a><% } %>
    <h2><a href="<%= post.url %>"><%= post.title %></a></h2>
    <%~ include("_post-meta", { post: post }) %>
    <p><%= truncatewords(fallback(post.excerpt, strip_html(post.body)), 30) %></p>
  </li>
  <% }) %>
</ul>
<% } %>

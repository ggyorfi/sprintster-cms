<% if (it.image.sources) { %><picture><% it.image.sources.forEach(function (source) { %><source type="<%= source.type %>" srcset="<%= source.srcset %>" sizes="<%= it.image.sizes %>"><% }) %><% } %><img<% if (it.class) { %> class="<%= it.class %>"<% } %> src="<%= it.image.src %>"<% if (it.image.srcset) { %> srcset="<%= it.image.srcset %>" sizes="<%= it.image.sizes %>"<% } %> alt="<%= it.image.alt %>"<% if (it.image.width) { %> width="<%= it.image.width %>" height="<%= it.image.height %>"<% } %><% if (it.lazy) { %> loading="lazy"<% } %> decoding="async"><% if (it.image.sources) { %></picture><% } %>

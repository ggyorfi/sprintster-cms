{
  "name": "sprintster-cms",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "scms": "./dist/scms.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "theme"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/scms.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "eta": "^4.0.1",
    "hono": "^4.13.5",
    "markdown-it": "^14.1.0",
    "sharp": "^0.34.5",
    "shiki": "^3.15.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "sprintster": "^1.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "sprintster": "latest",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
